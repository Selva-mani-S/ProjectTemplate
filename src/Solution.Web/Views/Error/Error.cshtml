@{
    ViewData["Title"] = "Error";
    var statusCode = ViewData["StatusCode"] ?? 500;
}

<div class="text-center py-5">
    <h1 class="display-1 fw-bold text-danger">@statusCode</h1>
    <h2 class="h4 text-dark mb-3">An Error Occurred</h2>
    <p class="text-muted">An error occurred while processing your request. Internal details have been logged for administrative review.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3"><i class="bi bi-house-door me-1"></i>Return Home</a>
</div>
