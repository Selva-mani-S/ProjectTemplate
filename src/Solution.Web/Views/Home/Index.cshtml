@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="p-5 mb-4 bg-white rounded-3 shadow-sm border border-secondary border-opacity-25 text-center">
            <div class="mb-3">
                <i class="bi bi-airplane-engines text-primary" style="font-size: 3.5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-dark">Indian Air Force Batch 1986</h1>
            <p class="lead text-muted fs-4">Grand 40-Year Reunion & Member Registry Portal</p>
            <p class="text-secondary max-w-75 mx-auto">
                Welcome veterans, spouses, and families. This portal enables all IAF Batch 1986 course members to maintain their registry details, submit reunion travel and accommodation preferences, confirm event fee payments, and receive official event announcements.
            </p>

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-primary btn-lg px-4 gap-3 shadow-sm">
                            <i class="bi bi-speedometer2 me-2"></i>Go to Admin Dashboard
                        </a>
                        <a asp-controller="MemberRegistry" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 shadow-sm">
                            <i class="bi bi-person-lines-fill me-2"></i>Member Registry
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Dashboard" asp-action="Member" class="btn btn-primary btn-lg px-4 gap-3 shadow-sm">
                            <i class="bi bi-house-door me-2"></i>My Reunion Dashboard
                        </a>
                        <a asp-controller="Reunion" asp-action="Register" class="btn btn-warning btn-lg px-4 shadow-sm">
                            <i class="bi bi-calendar-check me-2"></i>Register for Reunion
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login to Your Account
                    </a>
                }
            </div>
        </div>

        <div class="row g-4 py-2">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                    <div class="card-body p-4 text-center">
                        <div class="text-primary mb-3"><i class="bi bi-person-badge fs-1"></i></div>
                        <h4 class="fw-bold">Member Registry</h4>
                        <p class="text-muted small">Comprehensive database of all IAF 1986 batch comrades, trades, postings, and family records.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning">
                    <div class="card-body p-4 text-center">
                        <div class="text-warning mb-3"><i class="bi bi-compass fs-1"></i></div>
                        <h4 class="fw-bold">Event & Travel Logistics</h4>
                        <p class="text-muted small">Submit arrival times, transit points, accommodation requirements, T-shirt size, and catering preferences.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-success">
                    <div class="card-body p-4 text-center">
                        <div class="text-success mb-3"><i class="bi bi-shield-check fs-1"></i></div>
                        <h4 class="fw-bold">Fee Verification</h4>
                        <p class="text-muted small">Transparent fee tracking with member self-reporting, payment proof submission, and organizer verification audit.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
