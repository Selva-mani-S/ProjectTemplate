@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-white rounded-3 border shadow-sm">
    <div class="container-fluid py-2">
        <h1 class="display-5 fw-bold text-dark mb-3">
            <i class="bi bi-shield-check text-success me-2"></i>Production-Grade Security Baseline
        </h1>
        <p class="col-md-10 fs-5 text-secondary">
            Welcome to the Secure Baseline Portal. This application serves as a dedicated home screen enforcing strict OWASP Top 10 (2021) controls, Central Package Management (CPM), LibMan client-side governance, and ASP.NET Core Identity.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-4 p-3 bg-light rounded border">
                <h5 class="fw-bold text-primary mb-2"><i class="bi bi-person-badge-fill me-2"></i>Authenticated Dashboard</h5>
                <p class="mb-2">Logged in as <strong>@User.Identity.Name</strong></p>
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-primary shadow-sm">
                        <i class="bi bi-people-fill me-2"></i>Manage Department Users
                    </a>
                }
            </div>
        }
        else
        {
            <div class="mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Portal
                </a>
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white">
            <div class="card-body">
                <h5 class="card-title text-primary"><i class="bi bi-box-seam me-2"></i>Central Package Management</h5>
                <p class="card-text">All NuGet package versions are strictly pinned and managed via <code>Directory.Packages.props</code>. Project files contain zero <code>Version</code> attributes.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white">
            <div class="card-body">
                <h5 class="card-title text-success"><i class="bi bi-shield-shaded me-2"></i>Dynamic CSP & Nonce</h5>
                <p class="card-text">Every HTTP response receives a cryptographically generated CSP nonce ensuring script/style execution without using 'unsafe-inline'.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white">
            <div class="card-body">
                <h5 class="card-title text-warning"><i class="bi bi-people-fill me-2"></i>Department User Management</h5>
                <p class="card-text">Site administrators can manage department-level user accounts and roles via a dedicated admin portal screen.</p>
            </div>
        </div>
    </div>
</div>
