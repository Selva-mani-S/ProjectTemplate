@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <h1 class="display-1 fw-bold text-warning"><i class="bi bi-shield-slash"></i> 403</h1>
    <h2 class="h4 text-dark mb-3">Access Denied</h2>
    <p class="text-muted">You do not have permission to access the requested resource.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3">Return Home</a>
</div>
