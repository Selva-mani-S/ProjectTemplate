@model Solution.Web.Models.ActivateAccountViewModel
@{
    ViewData["Title"] = "Activate Your Account";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-3 mt-4">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Activate Member Account</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small text-center mb-4">
                    Welcome <strong>@Model.MemberName</strong> (Service No: <strong>@Model.ServiceNo</strong>). Please establish a secure password to activate your online reunion account.
                </p>

                <form asp-controller="Account" asp-action="Activate" method="post">
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ServiceNo" />
                    <input type="hidden" asp-for="MemberName" />

                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Registered Email</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="At least 12 characters" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text small">Must be at least 12 characters, including uppercase, lowercase, digit, and symbol.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small"></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i>Set Password & Activate Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
