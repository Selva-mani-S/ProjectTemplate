@model Solution.Application.DTOs.AdminDashboardStatsDto
@{
    ViewData["Title"] = "Organizer Dashboard";
    var events = ViewBag.Events as List<Solution.Application.DTOs.ReunionEventDto> ?? new();
    int selectedEventId = ViewBag.SelectedEventId is int id ? id : 1;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 text-primary me-2"></i>Organizer Dashboard</h2>
        <p class="text-muted small mb-0">Overview of Batch 1986 member registrations, logistical distributions, and fee collections.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" asp-action="Admin" class="d-inline-flex gap-2">
            <select name="eventId" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var ev in events)
                {
                    <option value="@ev.EventId" selected="@(ev.EventId == selectedEventId)">
                        @ev.Title (@ev.EventDate.ToString("yyyy"))
                    </option>
                }
            </select>
        </form>
        <a asp-controller="Report" asp-action="Index" class="btn btn-sm btn-primary">
            <i class="bi bi-file-earmark-text me-1"></i>View 14 Reports
        </a>
    </div>
</div>

<!-- Primary KPI Metrics -->
<div class="row g-3 mb-4">
    <!-- Members Card -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase">Registry Members</span>
                <i class="bi bi-person-lines-fill text-primary fs-4"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">@Model.TotalMembersInRegistry</h2>
            <div class="small text-muted">
                <span>@Model.TotalAccountsCreated provisioned</span> &bull;
                <span class="text-success fw-bold">@Model.ActiveAccountsCount active</span>
            </div>
            <div class="mt-2 pt-2 border-top">
                <a asp-controller="MemberRegistry" asp-action="Index" class="small text-decoration-none fw-bold">View Registry &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Attendance Card -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase">Reunion Headcount</span>
                <i class="bi bi-people-fill text-info fs-4"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">@Model.TotalExpectedAttendees</h2>
            <div class="small text-muted">
                <span>@Model.TotalRegisteredForReunion veterans</span> +
                <span>@Model.TotalAccompanyingPersons guests</span>
            </div>
            <div class="mt-2 pt-2 border-top">
                <a asp-controller="Reunion" asp-action="AdminList" asp-route-eventId="@selectedEventId" class="small text-decoration-none fw-bold">Manage Registrations &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Collections Verified Card -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase">Verified Collections</span>
                <i class="bi bi-cash-coin text-success fs-4"></i>
            </div>
            <h2 class="fw-bold text-success mb-1">₹@Model.TotalVerifiedAmountCollected.ToString("N0")</h2>
            <div class="small text-muted">
                <span>@Model.PaymentsVerifiedCount payments confirmed</span>
            </div>
            <div class="mt-2 pt-2 border-top">
                <a asp-controller="Payment" asp-action="AdminList" asp-route-eventId="@selectedEventId" class="small text-decoration-none fw-bold text-success">Fee Audit &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Pending / Outstanding Card -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase">Pending / Outstanding</span>
                <i class="bi bi-clock-history text-warning fs-4"></i>
            </div>
            <h2 class="fw-bold text-warning mb-1">@Model.PaymentsPendingVerificationCount</h2>
            <div class="small text-muted">
                <span>₹@Model.TotalOutstandingAmount.ToString("N0") outstanding</span>
            </div>
            <div class="mt-2 pt-2 border-top">
                <a asp-controller="Payment" asp-action="AdminList" asp-route-eventId="@selectedEventId" asp-route-status="PendingVerification" class="small text-decoration-none fw-bold text-warning">Review Submissions &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Statistics Grid -->
<div class="row g-4 mb-4">
    <!-- Logistical Distributions: T-Shirt & Meals -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tag-fill text-primary me-2"></i>T-Shirt & Catering Logistics</h5>
            </div>
            <div class="card-body p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">T-Shirt Sizes Required</h6>
                <div class="row g-2 mb-4">
                    @foreach (var size in new[] { "M", "L", "XL", "XXL" })
                    {
                        int count = Model.TShirtSizeDistribution.TryGetValue(size, out int c) ? c : 0;
                        <div class="col-3 text-center">
                            <div class="p-2 border rounded bg-light">
                                <span class="badge bg-dark fs-6 mb-1">@size</span>
                                <div class="fs-5 fw-bold text-dark">@count</div>
                            </div>
                        </div>
                    }
                </div>

                <h6 class="fw-bold text-muted small text-uppercase mb-3">Food & Drinking Preferences</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 border rounded">
                            <span class="text-muted small d-block">Meals Preference</span>
                            <div class="d-flex justify-content-between mt-2">
                                <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1"></i>Veg: @Model.VegetarianMealsCount</span>
                                <span class="text-danger fw-bold"><i class="bi bi-circle-fill me-1"></i>Non-Veg: @Model.NonVegetarianMealsCount</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border rounded">
                            <span class="text-muted small d-block">Beverage Preference</span>
                            <div class="d-flex justify-content-between mt-2">
                                <span class="text-dark fw-bold">Drinker: @Model.DrinkerCount</span>
                                <span class="text-muted fw-bold">Non-Drinker: @Model.NonDrinkerCount</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Accommodation Required:</span>
                    <span class="badge bg-primary fs-6">@Model.AccommodationRequiredCount members</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Arrival Transit Points & Payment Modes -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Arrival Transit & Payment Modes</h5>
            </div>
            <div class="card-body p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">Arrival Points Distribution</h6>
                <ul class="list-group list-group-flush mb-4">
                    @if (Model.ArrivalPlaceDistribution.Count == 0)
                    {
                        <li class="list-group-item text-muted small px-0">No arrival logistics reported yet.</li>
                    }
                    @foreach (var place in Model.ArrivalPlaceDistribution)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span><i class="bi bi-signpost-2 me-2 text-primary"></i>@place.Key</span>
                            <span class="badge bg-secondary">@place.Value members</span>
                        </li>
                    }
                </ul>

                <h6 class="fw-bold text-muted small text-uppercase mb-3">Fee Collection by Payment Mode</h6>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.PaymentModeDistribution.Count == 0)
                    {
                        <span class="text-muted small">No payment modes recorded yet.</span>
                    }
                    @foreach (var mode in Model.PaymentModeDistribution)
                    {
                        <span class="badge bg-light text-dark border p-2">
                            <strong>@mode.Key:</strong> @mode.Value transactions
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- State and Trade Distributions -->
<div class="row g-4">
    <!-- State-wise -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-map-fill text-primary me-2"></i>Members by State</h5>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive" style="max-height: 250px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>State</th>
                                <th class="text-end">Registered Members</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.StateWiseMemberDistribution.OrderByDescending(x => x.Value))
                            {
                                <tr>
                                    <td>@s.Key</td>
                                    <td class="text-end fw-bold">@s.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Trade-wise -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tools text-primary me-2"></i>Members by Air Force Trade</h5>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive" style="max-height: 250px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trade</th>
                                <th class="text-end">Registered Members</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TradeWiseMemberDistribution.OrderByDescending(x => x.Value))
                            {
                                <tr>
                                    <td>@t.Key</td>
                                    <td class="text-end fw-bold">@t.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
