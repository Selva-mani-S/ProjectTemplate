@model Solution.Web.Models.MemberRegistryIndexViewModel
@{
    ViewData["Title"] = "Member Registry";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-primary me-2"></i>IAF 1986 Member Registry</h2>
        <p class="text-muted small mb-0">Total Members Registered: <strong>@Model.TotalCount</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Import from Excel / CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>Add New Member
        </a>
    </div>
</div>

<!-- Search & Filters Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search by Service No, Name, Mobile..." value="@Model.Search" />
            </div>
            <div class="col-md-2">
                <select name="tradeId" class="form-select">
                    <option value="">All Trades</option>
                    @foreach (var trade in Model.Trades)
                    {
                        <option value="@trade.TradeId" selected="@(Model.TradeId == trade.TradeId)">@trade.TradeName (@trade.TradeId)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="stateId" class="form-select">
                    <option value="">All States</option>
                    @foreach (var state in Model.States)
                    {
                        <option value="@state.StateId" selected="@(Model.StateId == state.StateId)">@state.StateName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="unregisteredOnly" value="true" id="unregCheck" @(Model.UnregisteredOnly == true ? "checked" : "") />
                    <label class="form-check-label small" for="unregCheck">Unregistered Only</label>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Service No</th>
                    <th>Name</th>
                    <th>Trade</th>
                    <th>State</th>
                    <th>Mobile</th>
                    <th>Account Status</th>
                    <th>Reunion Reg</th>
                    <th>Fee Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Members.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>No members found matching the specified criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model.Members)
                    {
                        <tr>
                            <td><span class="badge bg-dark fw-bold px-2 py-1">@m.ServiceNo</span></td>
                            <td class="fw-semibold">@m.Name</td>
                            <td><span class="small text-muted">@(m.TradeName ?? "-")</span></td>
                            <td><span class="small text-muted">@(m.StateName ?? "-")</span></td>
                            <td><span class="small">@(m.MobileNo ?? "-")</span></td>
                            <td>
                                @if (m.HasUserAccount)
                                {
                                    @if (m.IsAccountActive)
                                    {
                                        <span class="badge bg-success badge-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger badge-pill">Inactive</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary badge-pill">No Account</span>
                                }
                            </td>
                            <td>
                                @if (m.HasRegisteredForReunion)
                                {
                                    <span class="badge bg-primary badge-pill">@m.RegistrationStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Not Registered</span>
                                }
                            </td>
                            <td>
                                @switch (m.PaymentStatus)
                                {
                                    case "Verified":
                                        <span class="badge bg-success badge-pill"><i class="bi bi-check me-1"></i>Paid</span>
                                        break;
                                    case "PendingVerification":
                                        <span class="badge bg-warning text-dark badge-pill">Pending Verif.</span>
                                        break;
                                    case "Rejected":
                                        <span class="badge bg-danger badge-pill">Rejected</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-secondary border">Unpaid</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@m.ServiceNo" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@m.ServiceNo" class="btn btn-outline-secondary btn-sm ms-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.Page of @Model.TotalPages (Showing @Model.Members.Count records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-tradeId="@Model.TradeId" asp-route-stateId="@Model.StateId">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-tradeId="@Model.TradeId" asp-route-stateId="@Model.StateId">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-tradeId="@Model.TradeId" asp-route-stateId="@Model.StateId">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
