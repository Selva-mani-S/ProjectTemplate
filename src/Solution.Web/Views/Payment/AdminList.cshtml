@model Solution.Web.Models.PaymentAdminIndexViewModel
@{
    ViewData["Title"] = "Fee Payments & Verification";
    var events = ViewBag.Events as List<Solution.Application.DTOs.ReunionEventDto> ?? new();
    var cspNonce = Context.Items[Solution.Web.Middleware.SecurityHeadersMiddleware.CspNonceKey]?.ToString() ?? string.Empty;

    var duplicateAcks = Model.Payments
        .Where(p => !string.IsNullOrWhiteSpace(p.AcknowledgementNumber))
        .GroupBy(p => p.AcknowledgementNumber!.Trim(), StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() > 1)
        .Select(g => g.Key)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-credit-card-2-front text-primary me-2"></i>Reunion Fee Collections</h2>
        <p class="text-muted small mb-0">Audit member payment claims, verify bank/UPI acknowledgements, and review receipts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Report" asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download Financial Reports
        </a>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-white p-3">
            <span class="text-muted small fw-bold text-uppercase">Total Collections Verified</span>
            <h3 class="fw-bold mb-0 text-success">₹@Model.TotalVerifiedAmount.ToString("N0")</h3>
            <span class="text-muted small">@Model.TotalVerifiedCount payments verified</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-white p-3">
            <span class="text-muted small fw-bold text-uppercase">Pending Verification</span>
            <h3 class="fw-bold mb-0 text-warning">@Model.TotalPendingCount</h3>
            <span class="text-muted small">Awaiting admin review</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-white p-3">
            <span class="text-muted small fw-bold text-uppercase">Rejected / Unconfirmed</span>
            <h3 class="fw-bold mb-0 text-danger">@Model.TotalRejectedCount</h3>
            <span class="text-muted small">Requiring resubmission</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-white p-3">
            <span class="text-muted small fw-bold text-uppercase">Flagged Duplicate Acks</span>
            <h3 class="fw-bold mb-0 text-danger">@duplicateAcks.Count</h3>
            <span class="text-muted small">Requires scrutiny</span>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AdminList" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="eventId" class="form-select" onchange="this.form.submit()">
                    @foreach (var ev in events)
                    {
                        <option value="@ev.EventId" selected="@(ev.EventId == Model.EventId)">
                            @ev.Title (@ev.EventDate.ToString("yyyy"))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search Service No, Name, Ack No..." value="@Model.Search" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="PendingVerification" selected="@(Model.SelectedStatus == Solution.Domain.Enums.PaymentStatus.PendingVerification)">Pending Verification</option>
                    <option value="Verified" selected="@(Model.SelectedStatus == Solution.Domain.Enums.PaymentStatus.Verified)">Verified</option>
                    <option value="Rejected" selected="@(Model.SelectedStatus == Solution.Domain.Enums.PaymentStatus.Rejected)">Rejected</option>
                    <option value="Unpaid" selected="@(Model.SelectedStatus == Solution.Domain.Enums.PaymentStatus.Unpaid)">Unpaid</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="mode" class="form-select">
                    <option value="">All Modes</option>
                    <option value="UPI" selected="@(Model.SelectedMode == Solution.Domain.Enums.PaymentMode.UPI)">UPI</option>
                    <option value="BankTransfer" selected="@(Model.SelectedMode == Solution.Domain.Enums.PaymentMode.BankTransfer)">Bank Transfer</option>
                    <option value="Cash" selected="@(Model.SelectedMode == Solution.Domain.Enums.PaymentMode.Cash)">Cash</option>
                    <option value="Cheque" selected="@(Model.SelectedMode == Solution.Domain.Enums.PaymentMode.Cheque)">Cheque</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="AdminList" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Payments Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Service No</th>
                    <th>Member Name</th>
                    <th>Amount</th>
                    <th>Mode</th>
                    <th>Acknowledgement / Reference</th>
                    <th>Payment Date</th>
                    <th>Proof</th>
                    <th>Status</th>
                    <th>Verification Audit</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt-cutoff fs-3 d-block mb-2"></i>
                            No payment records matching the selected filters.
                        </td>
                    </tr>
                }
                @foreach (var p in Model.Payments)
                {
                    bool isDuplicate = !string.IsNullOrWhiteSpace(p.AcknowledgementNumber) && duplicateAcks.Contains(p.AcknowledgementNumber.Trim());
                    <tr class="@(isDuplicate ? "table-warning" : "")">
                        <td class="fw-bold">@p.ServiceNo</td>
                        <td>@p.MemberName</td>
                        <td class="fw-bold text-dark">₹@p.AmountPaid.ToString("N0")</td>
                        <td><span class="badge bg-secondary">@p.PaymentMode</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.AcknowledgementNumber))
                            {
                                <span class="font-monospace small">@p.AcknowledgementNumber</span>
                                @if (isDuplicate)
                                {
                                    <span class="badge bg-danger ms-1" title="Duplicate Acknowledgement Number across registrations!"><i class="bi bi-exclamation-triangle-fill"></i> Duplicate Ack</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small">@p.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.PaymentProofPath))
                            {
                                <a asp-action="Proof" asp-route-id="@p.PaymentId" target="_blank" class="btn btn-sm btn-outline-info" title="View Uploaded Document">
                                    <i class="bi bi-file-earmark-image"></i> Proof
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td>
                            @switch (p.PaymentStatus)
                            {
                                case Solution.Domain.Enums.PaymentStatus.Verified:
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Verified</span>
                                    break;
                                case Solution.Domain.Enums.PaymentStatus.PendingVerification:
                                case Solution.Domain.Enums.PaymentStatus.PaymentDetailsSubmitted:
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    break;
                                case Solution.Domain.Enums.PaymentStatus.Rejected:
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Unpaid</span>
                                    break;
                            }
                        </td>
                        <td class="small">
                            @if (p.VerifiedAtUtc.HasValue)
                            {
                                <div><strong class="text-dark">@p.VerifiedBy</strong></div>
                                <div class="text-muted">@p.VerifiedAtUtc.Value.ToString("dd MMM yyyy, HH:mm")</div>
                                @if (!string.IsNullOrWhiteSpace(p.RejectionReason))
                                {
                                    <div class="text-danger small fst-italic">Note: @p.RejectionReason</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <!-- Verify Button -->
                                <form asp-action="Verify" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PaymentId" value="@p.PaymentId" />
                                    <input type="hidden" name="IsApproved" value="true" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve & Verify Payment" @(p.PaymentStatus == Solution.Domain.Enums.PaymentStatus.Verified ? "disabled" : "")>
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>

                                <!-- Reject Button triggers modal -->
                                <button type="button" class="btn btn-sm btn-outline-danger btn-reject"
                                        data-id="@p.PaymentId"
                                        data-member="@p.MemberName (@p.ServiceNo)"
                                        data-amount="₹@p.AmountPaid.ToString("N0")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rejectModal"
                                        title="Reject Payment">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Reject Payment -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="rejectModalLabel"><i class="bi bi-x-circle me-2"></i>Reject Payment Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Verify" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.EventId" />
                <input type="hidden" id="rejectPaymentId" name="PaymentId" />
                <input type="hidden" name="IsApproved" value="false" />

                <div class="modal-body p-4">
                    <p class="small text-muted mb-2">Member: <strong id="rejectMemberDisplay" class="text-dark"></strong></p>
                    <p class="small text-muted mb-3">Amount: <strong id="rejectAmountDisplay" class="text-dark"></strong></p>

                    <div class="mb-3">
                        <label for="rejectReason" class="form-label fw-bold small">Reason for Rejection (Required)</label>
                        <textarea id="rejectReason" name="RejectionReason" class="form-control" rows="3" required placeholder="e.g. Transaction reference not found in bank statement, amount mismatch, or illegible receipt."></textarea>
                        <div class="form-text small">This reason will be visible to the member so they can correct and resubmit their details.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@cspNonce">
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-reject').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var member = this.getAttribute('data-member');
                    var amount = this.getAttribute('data-amount');

                    document.getElementById('rejectPaymentId').value = id;
                    document.getElementById('rejectMemberDisplay').textContent = member;
                    document.getElementById('rejectAmountDisplay').textContent = amount;
                    document.getElementById('rejectReason').value = '';
                });
            });
        });
    </script>
}
