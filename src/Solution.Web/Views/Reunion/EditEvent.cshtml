@model Solution.Web.Models.ReunionEventViewModel
@{
    bool isNew = Model.EventId == 0;
    ViewData["Title"] = isNew ? "Create Reunion Event" : $"Configure Event - {Model.Title}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0 text-dark">
                    <i class="bi @(isNew ? "bi-calendar-plus" : "bi-pencil-square") text-primary me-2"></i>
                    @(isNew ? "Create New Reunion Event" : "Configure Event Settings")
                </h2>
                <p class="text-muted small mb-0">Define reunion dates, venue location, registration fee, and attendance deadline.</p>
            </div>
            <a asp-action="Events" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Events
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="EditEvent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EventId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold small"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. IAF Batch 1986 Ruby Reunion" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Batch" class="form-label fw-bold small"></label>
                            <input asp-for="Batch" class="form-control" placeholder="1986" required />
                            <span asp-validation-for="Batch" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label fw-bold small"></label>
                            <input asp-for="EventDate" type="date" class="form-control" required />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventEndDate" class="form-label fw-bold small"></label>
                            <input asp-for="EventEndDate" type="date" class="form-control" />
                            <span asp-validation-for="EventEndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Venue" class="form-label fw-bold small"></label>
                            <input asp-for="Venue" class="form-control" placeholder="e.g. Air Force Station, Tambaram / Officers Mess" required />
                            <span asp-validation-for="Venue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RegistrationDeadline" class="form-label fw-bold small"></label>
                            <input asp-for="RegistrationDeadline" type="date" class="form-control" required />
                            <span asp-validation-for="RegistrationDeadline" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="BaseFeeAmount" class="form-label fw-bold small"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseFeeAmount" type="number" step="0.01" class="form-control" required />
                            </div>
                            <span asp-validation-for="BaseFeeAmount" class="text-danger small"></span>
                            <div class="form-text small">Configured reunion fee per member.</div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" />
                                <label class="form-check-label fs-6 fw-bold" for="isActiveSwitch">Active Reunion Event</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter reunion schedule, special instructions, dress code, or coordinator details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                            <i class="bi bi-save me-1"></i>Save Event Configuration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
