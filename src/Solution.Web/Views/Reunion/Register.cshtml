@model Solution.Web.Models.ReunionRegistrationViewModel
@{
    ViewData["Title"] = "Reunion Registration & Preferences";
    var cspNonce = Context.Items[Solution.Web.Middleware.SecurityHeadersMiddleware.CspNonceKey]?.ToString() ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Event Header Card -->
        <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="badge bg-warning text-dark px-3 py-2 mb-2 fw-bold text-uppercase">Batch 1986 Reunion</span>
                        <h2 class="fw-bold mb-1">@Model.EventTitle</h2>
                        <p class="mb-0 text-white-50">
                            <i class="bi bi-geo-alt-fill me-1"></i>@Model.Venue &bull;
                            <i class="bi bi-calendar-event me-1"></i>@Model.EventDate.ToString("dd MMMM yyyy")
                        </p>
                    </div>
                    <div class="text-lg-end">
                        <div class="small text-white-50">Base Reunion Fee</div>
                        <div class="fs-3 fw-bold">₹@Model.BaseFeeAmount.ToString("N0")</div>
                        <span class="badge bg-light text-dark">Deadline: @Model.RegistrationDeadline.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsClosed)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Registration Window Closed.</strong> The registration deadline was @Model.RegistrationDeadline.ToString("dd MMM yyyy"). You may view your submitted preferences below.
                </div>
            </div>
        }

        <!-- Current Status Banner -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="text-muted small">Member:</span>
                    <strong class="text-dark ms-1">@Model.MemberName</strong>
                    <span class="badge bg-secondary ms-1">Service No: @Model.ServiceNo</span>
                </div>
                <div>
                    <span class="text-muted small me-2">Registration Status:</span>
                    @switch (Model.CurrentStatus)
                    {
                        case Solution.Domain.Enums.RegistrationStatus.Confirmed:
                            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                            break;
                        case Solution.Domain.Enums.RegistrationStatus.Submitted:
                            <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-clock-history me-1"></i>Submitted</span>
                            break;
                        case Solution.Domain.Enums.RegistrationStatus.Cancelled:
                            <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                            break;
                        default:
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-pencil-square me-1"></i>Pending Submission</span>
                            break;
                    }
                </div>
            </div>
        </div>

        <!-- Registration Form Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-ui-checks me-2 text-primary"></i>Attendance & Logistical Preferences</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="ServiceNo" />
                    <input type="hidden" asp-for="EventTitle" />
                    <input type="hidden" asp-for="Venue" />
                    <input type="hidden" asp-for="BaseFeeAmount" />
                    <input type="hidden" asp-for="RegistrationDeadline" />
                    <input type="hidden" asp-for="MemberName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Attendance & Accompanying Persons -->
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">1. Attendance & Guests</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="NoOfPersons" class="form-label fw-bold small"></label>
                            <input asp-for="NoOfPersons" type="number" min="1" max="10" class="form-control" required disabled="@Model.IsClosed" />
                            <span asp-validation-for="NoOfPersons" class="text-danger small"></span>
                            <div class="form-text small">Including yourself and family members.</div>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="AccompDetails" class="form-label fw-bold small"></label>
                            <input asp-for="AccompDetails" class="form-control" placeholder="e.g. Spouse: Priya, Son: Rahul" disabled="@Model.IsClosed" />
                            <span asp-validation-for="AccompDetails" class="text-danger small"></span>
                            <div class="form-text small">Names and relationship of family members attending.</div>
                        </div>
                    </div>

                    <!-- Travel Itinerary -->
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">2. Travel & Transit Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DateOfArrival" class="form-label fw-bold small"></label>
                            <input asp-for="DateOfArrival" type="datetime-local" class="form-control" disabled="@Model.IsClosed" />
                            <span asp-validation-for="DateOfArrival" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PlaceOfArrival" class="form-label fw-bold small"></label>
                            <select asp-for="PlaceOfArrival" class="form-select" disabled="@Model.IsClosed">
                                <option value="Airport">Chennai Airport (MAA)</option>
                                <option value="Egmore">Chennai Egmore Railway Station</option>
                                <option value="Central">Chennai Central Railway Station</option>
                                <option value="Tambaram">Tambaram Railway / Bus Station</option>
                                <option value="Self / Local">Own Transport / Local Resident</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="PlaceOfArrival" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfDeparture" class="form-label fw-bold small"></label>
                            <input asp-for="DateOfDeparture" type="datetime-local" class="form-control" disabled="@Model.IsClosed" />
                            <span asp-validation-for="DateOfDeparture" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PlaceOfDeparture" class="form-label fw-bold small"></label>
                            <select asp-for="PlaceOfDeparture" class="form-select" disabled="@Model.IsClosed">
                                <option value="Airport">Chennai Airport (MAA)</option>
                                <option value="Egmore">Chennai Egmore Railway Station</option>
                                <option value="Central">Chennai Central Railway Station</option>
                                <option value="Tambaram">Tambaram Railway / Bus Station</option>
                                <option value="Self / Local">Own Transport / Local Resident</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="PlaceOfDeparture" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Accommodation -->
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">3. Accommodation Requirements</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Accommodation" class="form-label fw-bold small"></label>
                            <input asp-for="Accommodation" class="form-control" placeholder="e.g. Air Force Mess / Guesthouse required for 2 nights, or Self-arranged" disabled="@Model.IsClosed" />
                            <span asp-validation-for="Accommodation" class="text-danger small"></span>
                            <div class="form-text small">Specify room type, dates, or if self-arranging stay.</div>
                        </div>
                    </div>

                    <!-- Preferences: T-Shirt, Catering, Drinks -->
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">4. Event Preferences & Souvenirs</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="TShirt" class="form-label fw-bold small"></label>
                            <select asp-for="TShirt" class="form-select" disabled="@Model.IsClosed">
                                <option value="M">M (Medium - 38-40)</option>
                                <option value="L">L (Large - 40-42)</option>
                                <option value="XL">XL (Extra Large - 42-44)</option>
                                <option value="XXL">XXL (Double Extra Large - 44-46)</option>
                            </select>
                            <span asp-validation-for="TShirt" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Food Preference (VegNonVeg)</label>
                            <div class="d-flex gap-3 pt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="VegNonVeg" value="0" id="mealVeg" disabled="@Model.IsClosed" />
                                    <label class="form-check-label" for="mealVeg">
                                        <i class="bi bi-circle-fill text-success me-1"></i>Vegetarian
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="VegNonVeg" value="1" id="mealNonVeg" disabled="@Model.IsClosed" />
                                    <label class="form-check-label" for="mealNonVeg">
                                        <i class="bi bi-circle-fill text-danger me-1"></i>Non-Vegetarian
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="VegNonVeg" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Drinking Preference (Drinker)</label>
                            <div class="d-flex gap-3 pt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Drinker" value="0" id="drinkerNo" disabled="@Model.IsClosed" />
                                    <label class="form-check-label" for="drinkerNo">Non-Drinker</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Drinker" value="1" id="drinkerYes" disabled="@Model.IsClosed" />
                                    <label class="form-check-label" for="drinkerYes">Drinker</label>
                                </div>
                            </div>
                            <span asp-validation-for="Drinker" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (!Model.IsClosed)
                    {
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Dashboard" asp-action="Member" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                                Save Preferences & Proceed to Payment<i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Dashboard" asp-action="Member" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                            </a>
                            <a asp-controller="Payment" asp-action="Submit" asp-route-eventId="@Model.EventId" class="btn btn-primary">
                                View / Submit Payment Details<i class="bi bi-credit-card ms-2"></i>
                            </a>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
