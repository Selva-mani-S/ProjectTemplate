@model List<Solution.Application.DTOs.ReunionRegistrationDto>
@{
    ViewData["Title"] = "Reunion Registrations";
    var events = ViewBag.Events as List<Solution.Application.DTOs.ReunionEventDto> ?? new();
    int selectedEventId = ViewBag.SelectedEventId is int id ? id : 1;
    var currentEvent = events.FirstOrDefault(e => e.EventId == selectedEventId);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Reunion Registrations</h2>
        <p class="text-muted small mb-0">Review veteran attendance, logistical requirements, and update registration statuses.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Events" class="btn btn-outline-primary">
            <i class="bi bi-gear me-1"></i>Manage Events
        </a>
        <a asp-controller="Report" asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export Reports
        </a>
    </div>
</div>

<!-- Event Selector & Filter Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AdminList" class="row g-2 align-items-center">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-0">Select Reunion Event:</label>
                <select name="eventId" class="form-select" onchange="this.form.submit()">
                    @foreach (var ev in events)
                    {
                        <option value="@ev.EventId" selected="@(ev.EventId == selectedEventId)">
                            @ev.Title (@ev.EventDate.ToString("dd MMM yyyy")) @(ev.IsActive ? "— [Active]" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-7 text-md-end pt-3">
                <span class="badge bg-primary px-3 py-2 fs-6 me-2">
                    Total Registrations: @Model.Count
                </span>
                <span class="badge bg-success px-3 py-2 fs-6 me-2">
                    Confirmed: @Model.Count(r => r.RegistrationStatus == Solution.Domain.Enums.RegistrationStatus.Confirmed)
                </span>
                <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                    Attendees: @Model.Sum(r => r.NoOfPersons)
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Registrations Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Service No</th>
                    <th>Member Name</th>
                    <th>Attendees</th>
                    <th>Arrival</th>
                    <th>Departure</th>
                    <th>Accommodation</th>
                    <th>T-Shirt</th>
                    <th>Diet / Drink</th>
                    <th>Status</th>
                    <th class="text-end">Update Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                            No registration preferences have been submitted yet for this event.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.ServiceNo</td>
                        <td>
                            <div>@item.MemberName</div>
                            @if (!string.IsNullOrWhiteSpace(item.AccompDetails))
                            {
                                <small class="text-muted d-block font-monospace">Accomp: @item.AccompDetails</small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info text-dark fs-6">@item.NoOfPersons</span>
                        </td>
                        <td>
                            <div class="small fw-bold">@(item.PlaceOfArrival ?? "—")</div>
                            <div class="text-muted small">@(item.DateOfArrival?.ToString("dd MMM HH:mm") ?? "—")</div>
                        </td>
                        <td>
                            <div class="small fw-bold">@(item.PlaceOfDeparture ?? "—")</div>
                            <div class="text-muted small">@(item.DateOfDeparture?.ToString("dd MMM HH:mm") ?? "—")</div>
                        </td>
                        <td>
                            <span class="small">@(item.Accommodation ?? "None")</span>
                        </td>
                        <td>
                            <span class="badge bg-dark">@(item.TShirt ?? "—")</span>
                        </td>
                        <td>
                            <div class="small">
                                @(item.VegNonVeg == 0 ? "Veg" : "Non-Veg") &bull;
                                @(item.Drinker == 1 ? "Drinker" : "Non-Drinker")
                            </div>
                        </td>
                        <td>
                            @switch (item.RegistrationStatus)
                            {
                                case Solution.Domain.Enums.RegistrationStatus.Confirmed:
                                    <span class="badge bg-success">Confirmed</span>
                                    break;
                                case Solution.Domain.Enums.RegistrationStatus.Submitted:
                                    <span class="badge bg-primary">Submitted</span>
                                    break;
                                case Solution.Domain.Enums.RegistrationStatus.Cancelled:
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reunionId" value="@item.ReunionId" />
                                <input type="hidden" name="eventId" value="@selectedEventId" />
                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="Pending" selected="@(item.RegistrationStatus == Solution.Domain.Enums.RegistrationStatus.Pending)">Pending</option>
                                    <option value="Submitted" selected="@(item.RegistrationStatus == Solution.Domain.Enums.RegistrationStatus.Submitted)">Submitted</option>
                                    <option value="Confirmed" selected="@(item.RegistrationStatus == Solution.Domain.Enums.RegistrationStatus.Confirmed)">Confirmed</option>
                                    <option value="Cancelled" selected="@(item.RegistrationStatus == Solution.Domain.Enums.RegistrationStatus.Cancelled)">Cancelled</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
