@{
    var cspNonce = Context.Items[SecurityHeadersMiddleware.CspNonceKey]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IAF Batch 1986 Reunion Portal</title>

    <!-- Pinned local Bootstrap 5 & Bootstrap Icons managed via LibMan -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <style nonce="@cspNonce">
        .iaf-header {
            background: linear-gradient(135deg, #0b2545 0%, #134074 50%, #1d3557 100%);
        }
        .stat-card {
            border-radius: 0.75rem;
            transition: transform 0.15s ease-in-out;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .badge-pill {
            border-radius: 50rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark iaf-header border-bottom shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-engines-fill text-warning me-2 fs-4"></i>
                    <span>IAF 1986 <span class="badge bg-warning text-dark ms-1">Reunion</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MemberRegistry" asp-action="Index"><i class="bi bi-person-lines-fill me-1"></i>Member Registry</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MemberAccount" asp-action="Index"><i class="bi bi-people-fill me-1"></i>User Accounts</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reunion" asp-action="AdminList"><i class="bi bi-calendar-check me-1"></i>Registrations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Payment" asp-action="AdminList"><i class="bi bi-credit-card me-1"></i>Fee Payments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Report" asp-action="Index"><i class="bi bi-file-earmark-bar-graph me-1"></i>Reports</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reunion" asp-action="Events"><i class="bi bi-gear me-1"></i>Events</a>
                            </li>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Member"><i class="bi bi-house-door me-1"></i>My Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reunion" asp-action="Register"><i class="bi bi-calendar-check me-1"></i>Reunion Registration</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Payment" asp-action="Submit"><i class="bi bi-credit-card me-1"></i>Fee Payment</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <span class="badge bg-secondary text-light px-3 py-2">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                    @if (User.IsInRole("Administrator"))
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Admin</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Member / Admin Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 flex-grow-1 py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top bg-white text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; @DateTime.UtcNow.Year - <strong>Indian Air Force Batch 1986 Reunion Management & Member Registry</strong>
            <span class="mx-2">|</span>
            <span class="text-secondary">Touch The Sky With Glory &bull; नभः स्पृशं दीप्तम्</span>
        </div>
    </footer>

    <!-- Local Bootstrap JS consuming dynamic CSP Nonce -->
    <script nonce="@cspNonce" src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
